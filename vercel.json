{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{content/**,public/admin/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/reading/cards",
      "destination": "/api/index?route=reading/cards"
    },
    {
      "source": "/api/public/content",
      "destination": "/api/index?route=public/content"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/index?route=auth/login"
    },
    {
      "source": "/api/auth/callback",
      "destination": "/api/index?route=auth/callback"
    },
    {
      "source": "/api/auth/session",
      "destination": "/api/index?route=auth/session"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/index?route=auth/logout"
    },
    {
      "source": "/api/admin/content",
      "destination": "/api/index?route=admin/content"
    },
    {
      "source": "/api/admin/history",
      "destination": "/api/index?route=admin/history"
    },
    {
      "source": "/api/admin/rollback",
      "destination": "/api/index?route=admin/rollback"
    },
    {
      "source": "/data/today.json",
      "destination": "/api/index?route=data/today.json"
    },
    {
      "source": "/data/reading.json",
      "destination": "/api/index?route=data/reading.json"
    },
    {
      "source": "/admin",
      "destination": "/api/index?route=admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/index?route=admin"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "ignoreCommand": "node scripts/ignore-build.mjs"
}
